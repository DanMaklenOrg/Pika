game palworld ~> 'Palworld';
import steam(1623730);

// Achievements
achievement 'Ultimate Tamer' {
    objective 'Capture all Pals x5' {
        description 'Capture all pals at least 5 times each.';
        criterion pal;
    }
    objective 'Befriend Zoe & Grizzbolt';
}
achievement 'Max Player Level' { description 'Reach level 80.'; }
achievement 'Max Player Stats' {
    objective 'Max Health';
    objective 'Max Stamina';
    objective 'Max Attack';
    objective 'Max Work Speed';
    objective 'Max Weight';
    objective 'Max Capture Power';
    objective 'Max Satiety Duration';
    objective 'Max Swimming Ability';
    objective 'Max Food Preservation';
    objective 'Max Jump Power';
    objective 'Max Flight capacity';
    objective 'Max Climbing Proficiency';
    objective 'Max Status Resistance';
    objective 'Max Endurance';
    objective 'Max Sphere Tracking';
    objective 'Max EXP Gain';
    objective 'Max Rainbow Fortune';
}
achievement 'Max Base Level' { description 'Upgrade your base to level 35.'; }
achievement 'Bosses Defeated' {
    description 'Defeat all bosses at least once';
    objective 'Defeat Field Bosses' { criterion pal #field_boss; }
    objective 'Defeat Wanted Fugitives' { criterion wanted_fugitive; }
    objective 'Defeat Tower Bosses (Normal)' { criterion tower_boss; }
    objective 'Defeat Tower Bosses (Hard)' { criterion tower_boss; }
    objective 'Defeat Panthalus';
    objective 'Defeat Boss in Rotmist Root';
    objective 'Defeat Boss in Shinespore Root';
    objective 'Defeat Boss in Forbidden Laboratory';
}
achievement 'Mission Complete' {
    description 'Complete all the missions';
    objective 'Complete all main missions' { criterion mission #mission_main; }
    objective 'Complete all sub missions' { criterion mission #mission_sub; }
}
achievement 'Map Unlocked' {
    description 'Unlock fast travel points at all Great Eagle Statues and Watchtowers';
    objective 'Unlock all Great Eagle Statues' { criterion great_eagle_statue; }
    objective 'Unlock all Watchtowers' { criterion watchtower; }
    objective 'Unlock all Warp Alters in Sunreach';
    objective 'Fully reveal Palpagos Islands Map';
    objective 'Fully reveal World Tree Map';
}

achievement 'Maxed Parties' {
    description 'Have a party preset with maxed pals for common use cases';
    objective 'Maxed Exploration Party' { description 'For general exploration. No specialized use case.'; }
    objective 'Maxed Haggling Party' { description 'For better deals while trading wiy=th merchants.'; }
    objective 'Maxed Work Suitability Party' { description 'For crafting and assisting in base work.'; }
    objective 'Maxed World Tree Farm Party' { description 'For farming holy water, relics, dog coin, ... etc.'; }
    objective 'Maxed Bounty Token Farm Party' { description 'For farming bounty tokens.'; }
    objective 'Maxed Player Damage Party' { description 'For player focused gameplay.'; }
    objective 'Maxed Arena Party' { description 'For farming arena tokens.'; }
    objective 'Maxed Fishing Party' { description 'For fishing farms.'; }
    objective 'Maxed Salvage Party' { description 'For Salvage farms.'; }
    objective 'Maxed EXP Farm Party' { description 'For maximizing EXP gain for maxing out pals.'; }
}
achievement 'Maxed Base' {
    description 'Have a maxed out base for common use cases';
    objective 'Build a HQ Base' { description 'Core storage, Player house, various crafts, ... etc.'; }
    objective 'Build a Warehouse Base' { description 'Mass storage.'; }
    objective 'Build a Genetics Lab' { description 'For Breeding and maxing Pals.'; }
    objective 'Build a Coin Farm Base' { description 'For farming Coins.'; }
    objective 'Build a Farmland' { description 'For crops, ranching, mass breading + butchering.'; }
    objective 'Build an AI Core Factory' { description 'For mass production of AI Cores.'; }
    objective 'Build a Cake factory' { description 'For mass production of all cake variants'; }
    objective 'Build a Raid Boss Base' { description 'For speed killing of Raid Bosses.'; }
}

achievement 'Equipped Pals' {
    description 'Build all Pal Gear.';
    criterion pal_gear;
}
achievement 'Upgraded Inventory' {
    objective 'Get max inventory size' { criterion inventory_upgrade #inventory_upgrade_pouch; }
    objective 'Unlock all weapon slots' { criterion inventory_upgrade #inventory_upgrade_holster; }
    objective 'Unlock all accessory slots' { criterion inventory_upgrade #inventory_upgrade_accessory; }
    objective 'Unlock all food slots' { criterion inventory_upgrade #inventory_upgrade_feed; }
}
achievement 'Misc Tools Obtained' { criterion misc_tool; }
achievement 'Technology Maxed' { criterion tech; }
achievement 'Pal Expeditions Unlocked' { criterion expedition; }
achievement 'Scientist' {
    description 'Research all research subjects in the Pal Labor Research Lab.';
    criterion research;
}
achievement 'Diary Found' {
    description 'Find all Journal Entries';
    criterion journal;
}

achievement 'Collector: Implants' { criterion implant; }
achievement 'Collector: Accessories' { criterion accessory; }

// Categories
category pal;
category wanted_fugitive;
category great_eagle_statue;
category watchtower;
category tower_boss;
category mission;
category implant;
category accessory;
category pal_gear;
category inventory_upgrade;
category misc_tool;
category tech;
category expedition;
category research;
category journal;

// Tags
tag mission_main ~> 'Main Mission';
tag mission_sub ~> 'Sub Mission';
tag field_boss ~> 'Field Boss';
tag inventory_upgrade_pouch ~> 'Pouch';
tag inventory_upgrade_holster ~> 'Weapon Holster';
tag inventory_upgrade_feed ~> 'Feed Bag';
tag inventory_upgrade_accessory ~> 'Accessory Box';
tag misc_tool_lantern ~> 'Hip Lantern';
tag misc_tool_lockpick ~> 'Lockpicks';
tag misc_tool_misc ~> 'Misc';
tag tech_tech ~> 'Technology';
tag tech_ancient ~> 'Ancient Technology';
tag work_suitability_kindling ~> 'Kindling';
tag work_suitability_watering ~> 'Watering';
tag work_suitability_planting ~> 'Planting';
tag work_suitability_generating_electricity ~> 'Generating Electricity';
tag work_suitability_handiwork ~> 'Handiwork';
tag work_suitability_gathering ~> 'Gathering';
tag work_suitability_lumbering ~> 'Lumbering';
tag work_suitability_mining ~> 'Mining';
tag work_suitability_medicine_production ~> 'Medicine Production';
tag work_suitability_cooling ~> 'Cooling';
tag work_suitability_transporting ~> 'Transporting';
tag work_suitability_farming ~> 'Farming';
